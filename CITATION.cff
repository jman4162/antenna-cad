    given-names: John
    email: jhodge007@gmail.com
repository-code: "https://github.com/jman4162/antenna-cad"
license: MIT
version: 0.1.1
date-released: "2026-08-11"
keywords:
  - antenna
  - phased array
  - PCB
  - KiCad
  - microstrip
  - patch antenna
  - openEMS
  - electromagnetics
  - electronic design automation
